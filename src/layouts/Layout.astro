--- 
import '../styles/global.css';
import 'katex/dist/katex.min.css';

export interface Props {
	title: string;
	description?: string;
	pageType?: 'website' | 'article';
	hideNav?: boolean;
	fullWidth?: boolean;
}

const {
	title,
	description = 'Daniel Mandragona\'s personal website.',
	pageType = 'website',
	hideNav = false,
	fullWidth = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content={pageType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<div class="progress-container" aria-hidden="true">
			<div class="progress-bar" id="myBar"></div>
		</div>
		{!hideNav && (
			<nav>
				<a href="/" class:list={{ active: Astro.url.pathname === '/' }}>Home</a>
				<a href="/blog" class:list={{ active: Astro.url.pathname === '/blog' || Astro.url.pathname.startsWith('/blog/') }}>Blog</a>
				<a href="/links" class:list={{ active: Astro.url.pathname === '/links' }}>Links</a>
			</nav>
		)}
		<div class:list={["container", { "full-width": fullWidth }]}>
			<slot />
		</div>
		<script is:inline>
			function updateProgressBar() {
				const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
				const bar = document.getElementById("myBar");
				if (bar) bar.style.width = scrolled + "%";
			}
			window.addEventListener('scroll', updateProgressBar, { passive: true });
			updateProgressBar();
		</script>
	</body>
<style>
	@keyframes gradient-animation {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}

	.container {
		box-sizing: border-box;
		width: 100%;
		max-width: 880px;
		margin: 0 auto;
		padding: 40px;
		color: white;
	}

	.container.full-width {
		max-width: none;
		padding: 0;
		margin: 0;
	}

	nav {
		position: absolute;
		top: 40px;
		left: 40px;
		z-index: 1;
	}

	nav a {
		color: white;
		text-decoration: none;
		margin-right: 30px;
		position: relative;
		font-size: 1.5em;
	}

	nav a::after {
		content: '';
		position: absolute;
		width: 100%;
		transform: scaleX(0);
		height: 3px;
		bottom: -6px;
		left: 0;
		background-image: linear-gradient(to right, #7456eb, #ec3636);
		transform-origin: bottom right;
		transition: transform 0.25s ease-out;
	}

	nav a:hover::after {
		transform: scaleX(1);
		transform-origin: bottom left;
	}

	nav a.active::after {
		transform: scaleX(1);
		transform-origin: bottom left;
		background-size: 200% 200%;
		animation: gradient-animation .75s linear infinite;
	}

	.progress-container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 8px;
		z-index: 100;
	}

	.progress-bar {
		height: 8px;
		background-image: linear-gradient(to right, #7456eb, #ec3636);
		width: 0%;
	}

	@media (max-width: 768px) {
		.container {
			padding: 20px;
		}

		nav {
			top: 28px;
			left: 20px;
		}

		nav a {
			font-size: 1.1rem;
			margin-right: 18px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		nav a,
		nav a::after {
			animation: none;
			transition: none;
		}
	}
</style>
</html>
