---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const rawPublicationDate = frontmatter.pubDate instanceof Date
    ? frontmatter.pubDate.toISOString()
    : String(frontmatter.pubDate);
const publicationDate = new Date(
    /^\d{4}-\d{2}-\d{2}$/.test(rawPublicationDate)
        ? `${rawPublicationDate}T00:00:00Z`
        : rawPublicationDate
);
const machineDate = publicationDate.toISOString().slice(0, 10);
const formattedDate = publicationDate.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
});
---
<Layout title={frontmatter.title} description={frontmatter.description} pageType="article">
    <article>
        <header class="post-header">
            <h1>{frontmatter.title}</h1>
            <p class="pub-date"><time datetime={machineDate}>{formattedDate}</time></p>
        </header>
        <div class="post-content">
            <slot />
        </div>
    </article>
</Layout>

<style>
  h1 {
    font-size: 2.5rem;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    background-image: linear-gradient(to right, #7456eb, #ec3636);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-align: center;
  }
  .post-header {
    margin-top: 80px;
  }
  .pub-date {
    color: #292524;
    text-align: center;
    font-style: italic;
    margin-bottom: 2rem;
  }
  .post-content {
    color: #333;
    font-size: 1.1rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  :global(.post-content h2),
  :global(.post-content h3) {
    line-height: 1.25;
    scroll-margin-top: 2rem;
  }
  :global(.post-content h2) {
    margin-top: 3.25rem;
  }
  :global(.post-content h3) {
    margin-top: 2.25rem;
  }
  :global(.post-content table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.5rem 0;
    -webkit-overflow-scrolling: touch;
  }
  :global(.post-content th),
  :global(.post-content td) {
    min-width: 8rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid rgba(31, 41, 55, 0.22);
    text-align: left;
    vertical-align: top;
  }
  :global(.post-content th) {
    background: rgba(255, 255, 255, 0.32);
  }
  :global(.post-content blockquote) {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 4px solid #7456eb;
  }
  :global(.post-content .katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 0.25rem;
  }
  :global(.post-content details) {
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(31, 41, 55, 0.22);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.18);
  }
  :global(.post-content summary) {
    cursor: pointer;
    font-weight: 700;
  }
  @media (max-width: 768px) {
    .post-header {
      margin-top: 88px;
    }
    h1 {
      font-size: clamp(2rem, 10vw, 2.5rem);
    }
    .post-content {
      font-size: 1rem;
      line-height: 1.65;
    }
    :global(.post-content h2) {
      margin-top: 2.75rem;
    }
  }
</style>
